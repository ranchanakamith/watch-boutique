PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/boutique.sqlite
NODE_ENV=development

# Welcome, password recovery and email verification delivery.
# Use a verified sender/domain in Resend. Without these, recovery/verification
# clearly report unavailable; welcome messages remain queued locally.
RESEND_API_KEY=
MAIL_FROM=

# Required in production: generate 32 random bytes as 64 hex characters.
# Back up this key securely; it encrypts authenticator secrets and queued email.
# In development, a private key is generated in backend/data/account-security.key.
ACCOUNT_SECURITY_KEY=
