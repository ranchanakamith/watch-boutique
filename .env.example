# Optional overrides. Defaults support a local lab demo without copying this file.
WEB_PORT=8080
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
POSTGRES_PASSWORD=boutique-lab-only
# Hosted PostgreSQL: paste the provider connection URL including its TLS options.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# ACCOUNT_SECURITY_KEY=64_HEX_CHARACTERS
